[
  {
    "title": "Scenes",
    "description": "standalone, no siblings",
    "components": [
      {
        "name": "AnimatedNumber",
        "id": "animatednumber",
        "description": "Animated counter that counts from one number to another with text labels. Use for metrics, statistics, KPIs. Required props: startText=\"Solved\", endText=\"incidents\", to={12450}. Optional: from (default 0), format (e.g. \"0,0\" for thousands separator).",
        "props": [
          {
            "name": "startText",
            "type": "string",
            "required": true
          },
          {
            "name": "endText",
            "type": "string",
            "required": true
          },
          {
            "name": "from",
            "type": "number",
            "required": false,
            "default": 0
          },
          {
            "name": "to",
            "type": "number",
            "required": true
          },
          {
            "name": "format",
            "type": "string",
            "required": false
          },
          {
            "name": "variant",
            "type": "enum(caption|label|body|subheading|heading|display)",
            "required": false,
            "default": "heading"
          },
          {
            "name": "highlightStyle",
            "type": "enum(marker|underline|box|glow|background)",
            "required": false,
            "default": "glow"
          },
          {
            "name": "highlightColor",
            "type": "string",
            "required": false
          },
          {
            "name": "animation",
            "type": "enum(fadeIn|slideUp|slideDown|slideLeft|slideRight|scaleIn|rotateIn)",
            "required": false,
            "default": "slideUp"
          },
          {
            "name": "animationDelay",
            "type": "number",
            "required": false,
            "default": 30
          },
          {
            "name": "durationInFrames",
            "type": "number",
            "required": false,
            "default": 45
          }
        ]
      },
      {
        "name": "TextStagger",
        "id": "textstagger",
        "description": "Reveals text word-by-word or character-by-character with staggered animation delays. Use for multi-word headlines or body text. Required props: text=\"Transform your workflow with AI\". Each unit animates in sequence with configurable delay. Set splitBy=\"char\" for character-level animation.",
        "props": [
          {
            "name": "startAt",
            "type": "number",
            "required": false
          },
          {
            "name": "text",
            "type": "string",
            "required": true
          },
          {
            "name": "variant",
            "type": "enum(caption|label|body|subheading|heading|display)",
            "required": false,
            "default": "heading"
          },
          {
            "name": "staggerDelay",
            "type": "number",
            "required": false,
            "default": 5
          },
          {
            "name": "entranceAnimation",
            "type": "enum(fadeIn|slideUp|slideDown|slideLeft|slideRight|scaleIn|rotateIn)",
            "required": false,
            "default": "scaleIn"
          },
          {
            "name": "duration",
            "type": "number",
            "required": false,
            "default": 15
          },
          {
            "name": "splitBy",
            "type": "enum(char|word|line)",
            "required": false,
            "default": "word"
          },
          {
            "name": "wordStyle",
            "type": "any",
            "required": false
          }
        ]
      },
      {
        "name": "Typewriter",
        "id": "typewriter",
        "description": "Reveals text character-by-character like a typewriter. Use for dramatic reveals or code/terminal effects. Required props: text=\"Building the future of AI\". Optional: mode=\"char\" (default), \"word\", or \"line\" to control typing granularity.",
