        "subheading",
        "heading",
        "display",
        "displayLg",
        "displayXl",
        "display2xl"
      ]
    },
    {
      "name": "entranceAnimation",
      "description": "used for entrance animations",
      "value": [
        "fadeIn",
        "slideUp",
        "slideDown",
        "slideLeft",
        "slideRight",
        "scaleIn",
        "rotateIn",
        "tiltX",
        "tiltY",
        "flipX",
        "flipY",
        "zoomRotate",
        "elasticScale",
        "swingIn"
      ]
    },
    {
      "name": "splitBy",
      "value": [
        "char",
        "word",
        "line"
      ]
    },
    {
      "name": "logoAnimation",
      "value": [
