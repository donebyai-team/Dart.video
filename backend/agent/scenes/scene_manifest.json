        "right",
        "up",
        "down"
      ]
    },
    {
      "name": "highlightStyle",
      "value": [
        "marker",
        "underline",
        "box",
        "glow",
        "background"
      ]
    },
    {
      "name": "textCycleTransition",
      "value": [
        "flipY",
        "fadeSwap",
        "slideUp"
      ]
    },
    {
      "name": "highlightedTextAnimation",
      "value": [
        "zoom",
        "jump"
      ]
    }
  ],
  "components": [
    {
      "title": "Scenes",
      "description": "standalone, no siblings",
      "components": [
        {
          "name": "AnimatedNumber",
          "type": "content",
          "schema": [
            {
              "type": "component",
              "name": "animatednumber",
              "fields": [
                {
                  "name": "entranceAnimation",
                  "type": "string",
                  "default": "slideUp"
                },
                {
                  "name": "animationDelay",
                  "type": "number",
                  "default": 30
                },
                {
                  "name": "startText",
                  "type": "string",
                  "map": "props.startText"
                },
                {
                  "name": "endText",
                  "type": "string",
                  "map": "props.endText"
                },
                {
                  "name": "from",
                  "type": "number",
                  "map": "props.from",
                  "default": 0
                },
                {
                  "name": "to",
                  "type": "number",
                  "map": "props.to",
                  "default": 100
                },
                {
                  "name": "format",
                  "type": "string",
                  "default": ""
                },
                {
                  "name": "variant",
                  "type": "string",
                  "subtype": "enum",
                  "default": "heading"
                }
              ]
            }
          ],
          "llmSchema": [
            {
              "name": "startText",
              "type": "string"
            },
            {
              "name": "endText",
              "type": "string"
            },
            {
              "name": "from",
              "type": "number"
            },
            {
              "name": "to",
              "type": "number"
            }
          ],
          "description": "Counting metric with label text. Use for stats and KPIs",
          "celExpression": "ceil(props.animatednumber.animationDelay + max(45, min(100, log10(abs(props.animatednumber.to - props.animatednumber.from) + 1) * 20)))"
        },
        {
          "name": "TextStagger",
          "type": "content",
          "schema": [
            {
              "type": "component",
              "name": "textstagger",
              "fields": [
                {
                  "name": "text",
                  "type": "string",
                  "map": "props.text"
                },
                {
                  "name": "variant",
                  "type": "string",
                  "subtype": "enum",
                  "default": "heading"
                },
                {
                  "name": "staggerDelay",
                  "type": "number",
                  "default": 5
                },
                {
                  "name": "entranceAnimation",
                  "type": "string",
                  "subtype": "enum",
                  "default": "scaleIn"
                },
                {
                  "name": "duration",
                  "type": "number",
                  "default": 15
                },
                {
                  "name": "splitBy",
                  "type": "string",
                  "subtype": "enum",
                  "default": "word"
                }
              ]
            }
          ],
          "llmSchema": [
            {
              "name": "text",
              "type": "string"
            }
          ],
          "description": "Reveals text word-by-word or character-by-character with staggered animation delays. Use for multi-word headlines or body text. Required props: text=\"Transform your workflow with AI\". Each unit animates in sequence with configurable delay. Set splitBy=\"char\" for character-level animation.",
          "celExpression": "ceil((size(props.textstagger.splitBy == \"char\" ? props.textstagger.text.split(\"\") : props.textstagger.splitBy == \"line\" ? props.textstagger.text.split(\"\\n\") : props.textstagger.text.split(\" \")) - 1) * props.textstagger.staggerDelay + props.textstagger.duration)"
        },
        {
          "name": "Typewriter",
          "type": "content",
          "schema": [
            {
              "type": "component",
              "name": "typewriter",
              "fields": [
                {
                  "name": "text",
                  "type": "string",
                  "required": true,
                  "map": "props.text"
                },
                {
                  "name": "variant",
                  "type": "string",
                  "subtype": "enum",
                  "default": "heading"
                },
                {
                  "name": "splitBy",
                  "type": "string",
                  "subtype": "enum",
                  "default": "char"
                },
                {
                  "name": "entranceAnimation",
                  "type": "string",
                  "subtype": "enum",
                  "default": "slideUp"
                },
                {
                  "name": "startAt",
                  "type": "number",
                  "default": 0
                }
              ]
            }
          ],
          "llmSchema": [
            {
              "name": "text",
              "type": "string"
            }
          ],
          "description": "Character-by-character text reveal. Use for dramatic reveals or code/terminal effects.",
          "celExpression": "max(30, props.typewriter.splitBy == \"char\" ? size(props.typewriter.text) * 2 : props.typewriter.splitBy == \"word\" ? size(props.typewriter.text.split(\" \")) * 9 : size(props.typewriter.text.split(\"\\n\")) * 18)"
        },
        {
          "name": "TextHighlight",
          "type": "content",
          "schema": [
            {
              "type": "component",
              "name": "texthighlight",
              "fields": [
                {
                  "name": "text",
                  "type": "string",
                  "map": "props.text"
                },
                {
                  "name": "variant",
                  "type": "string",
                  "subtype": "enum",
                  "default": "heading"
                },
                {
                  "name": "entranceAnimation",
                  "type": "string",
                  "subtype": "enum",
                  "default": "slideUp"
                },
                {
                  "name": "animationDelay",
                  "type": "number",
                  "default": 30
                },
                {
                  "name": "zoomDuration",
                  "type": "number",
                  "default": 30
                },
                {
                  "name": "highlightStyle",
                  "type": "string",
                  "subtype": "enum",
                  "default": "glow"
                },
                {
                  "name": "highlightedTextAnimation",
                  "type": "string",
                  "subtype": "enum",
                  "default": "jump"
                },
                {
                  "name": "highlightColor",
                  "type": "string",
                  "subtype": "color"
                }
              ]
            }
          ],
          "llmSchema": [
            {
              "name": "text",
              "type": "string"
            }
          ],
          "description": "Bold statement with an emphasized word/phrase. Use for key claims. Use {} to highlight. eg \"We build amazing {software}\"",
          "celExpression": "ceil(props.texthighlight.animationDelay + props.texthighlight.zoomDuration)"
        },
        {
          "name": "TextCycle",
          "type": "content",
          "schema": [
            {
              "type": "component",
              "name": "textcycle",
              "fields": [
                {
                  "name": "texts",
                  "type": "array",
                  "subtype": "string",
                  "map": "props.texts"
                },
                {
                  "name": "variant",
                  "type": "string",
                  "subtype": "enum",
                  "default": "displayXl"
                },
                {
                  "name": "textCycleTransition",
                  "type": "string",
                  "subtype": "enum",
                  "default": "slideUp"
                },
                {
                  "name": "holdDuration",
                  "type": "number",
                  "default": 20
                },
                {
                  "name": "transitionDuration",
                  "type": "number",
                  "default": 5
                }
              ]
            }
          ],
          "llmSchema": [
            {
              "name": "texts",
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          ],
          "description": "rotating text strings or words. Use for taglines, feature lists, multi highlights",
          "celExpression": "ceil((props.textcycle.holdDuration + props.textcycle.transitionDuration) * size(props.textcycle.texts))"
        },
        {
          "name": "TextWithWordCycle",
          "type": "content",
          "schema": [
            {
              "type": "component",
              "name": "textwithwordcycle",
              "fields": [
                {
                  "name": "text",
                  "type": "string",
                  "required": true,
                  "map": "props.text"
                },
                {
                  "name": "cyclingWords",
                  "type": "array",
                  "required": true,
                  "map": "props.cyclingWords",
                  "default": []
                },
                {
                  "name": "variant",
                  "type": "string",
                  "sub_type": "enum",
                  "default": "heading"
                },
                {
                  "name": "holdDuration",
                  "type": "number",
                  "default": 20
                },
                {
                  "name": "transitionDuration",
                  "type": "number",
                  "default": 10
                },
                {
                  "name": "textCycleTransition",
                  "type": "string",
                  "subtype": "enum",
                  "default": "slideUp"
                }
              ]
            }
          ],
          "llmSchema": [
            {
              "name": "text",
              "type": "string"
            },
            {
              "name": "cyclingWords",
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          ],
          "description": "Static text with cycling highlighted words at the end. Use for dynamic taglines like \"We build amazing [software/products/solutions]\"",
          "celExpression": "ceil((props.textwithwordcycle.holdDuration + props.textwithwordcycle.transitionDuration) * size(props.textwithwordcycle.cyclingWords))"
        },
        {
          "name": "AnimatedImage",
          "type": "scene",
          "tags": [
            "Solution",
            "Product Info"
          ],
          "schema": [
            {
              "type": "component",
              "name": "scene",
              "fields": [
                {
                  "name": "entranceAnimation",
                  "type": "string",
                  "subtype": "enum",
                  "default": "slideUp"
                }
              ]
            },
            {
              "type": "component",
              "name": "text",
              "fields": [
                {
                  "name": "text",
                  "type": "string",
                  "map": "props.text"
                },
                {
