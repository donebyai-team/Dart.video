                },
                {
                  "name": "duration",
                  "type": "number",
                  "default": 15
                },
                {
                  "name": "splitBy",
                  "type": "string",
                  "subtype": "enum",
                  "default": "word"
                }
              ]
            },
            {
              "type": "repeat",
