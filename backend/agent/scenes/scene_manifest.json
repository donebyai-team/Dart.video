[
  {
    "title": "Scenes",
    "description": "standalone, no siblings",
    "components": [
      {
        "name": "AnimatedNumber",
        "durationExpression": "ceil(props.animationDelay + max(45, min(100, log10(abs(props.to - props.from) + 1) * 20)))",
        "tags": [],
        "id": "animatednumber",
        "description": "Counting metric with label text. Use for stats and KPIs",
        "props": [
          {
            "name": "startText",
            "type": "string",
            "required": true,
            "default": ""
          },
          {
            "name": "endText",
            "type": "string",
            "required": true,
            "default": ""
          },
          {
            "name": "from",
            "type": "number",
            "required": true,
            "default": 0
          },
          {
            "name": "to",
            "type": "number",
            "required": true
          },
          {
            "name": "format",
            "type": "string",
            "required": false
          },
          {
            "name": "variant",
            "type": "enum(subheading|heading|display|displayLg|displayXl|display2xl)",
            "required": false,
            "default": "heading"
          },
          {
            "name": "highlightStyle",
            "type": "enum(marker|underline|box|glow|background)",
            "required": false,
            "default": "glow"
          },
          {
            "name": "highlightColor",
            "type": "string",
            "required": false
          },
          {
            "name": "entranceAnimation",
            "type": "enum(fadeIn|slideUp|slideDown|slideLeft|slideRight|scaleIn|rotateIn|tiltX|tiltY|flipX|flipY|zoomRotate|elasticScale|swingIn)",
            "required": false,
            "default": "slideUp"
          },
          {
            "name": "animationDelay",
            "type": "number",
            "required": false,
            "default": 30
          }
        ]
      },
      {
        "name": "TextStagger",
        "durationExpression": "ceil((size(props.splitBy == \"char\" ? props.text.split(\"\") : props.splitBy == \"line\" ? props.text.split(\"\\n\") : props.text.split(\" \")) - 1) * props.staggerDelay + props.duration)",
        "tags": [],
        "id": "textstagger",
        "description": "Reveals text word-by-word or character-by-character with staggered animation delays. Use for multi-word headlines or body text. Required props: text=\"Transform your workflow with AI\". Each unit animates in sequence with configurable delay. Set splitBy=\"char\" for character-level animation.",
        "props": [
          {
            "name": "startAt",
            "type": "number",
            "required": false,
            "default": 0
          },
          {
            "name": "text",
            "type": "string",
            "required": true,
            "default": ""
          },
          {
            "name": "variant",
            "type": "enum(subheading|heading|display|displayLg|displayXl|display2xl)",
            "required": true,
            "default": "heading"
          },
          {
            "name": "staggerDelay",
            "type": "number",
            "required": true,
            "default": 5
          },
          {
            "name": "entranceAnimation",
            "type": "enum(fadeIn|slideUp|slideDown|slideLeft|slideRight|scaleIn|rotateIn|tiltX|tiltY|flipX|flipY|zoomRotate|elasticScale|swingIn)",
            "required": true,
            "default": "scaleIn"
          },
          {
            "name": "duration",
            "type": "number",
            "required": true,
            "default": 15
          },
          {
            "name": "splitBy",
            "type": "enum(char|word|line)",
            "required": true,
            "default": "word"
          }
        ]
      },
      {
        "name": "Typewriter",
        "durationExpression": "max(30, props.splitBy == \"char\" ? size(props.text) * 2 : props.splitBy == \"word\" ? size(props.text.split(\" \")) * 9 : size(props.text.split(\"\\n\")) * 18)",
        "tags": [],
        "id": "typewriter",
        "description": "Character-by-character text reveal. Use for dramatic reveals or code/terminal effects.",
        "props": [
          {
            "name": "text",
            "type": "string",
            "required": true,
            "default": ""
          },
          {
            "name": "startAt",
            "type": "number",
            "required": false,
            "default": 0
          },
          {
            "name": "splitBy",
            "type": "enum(char|word|line)",
            "required": false,
            "default": "char"
          },
          {
            "name": "variant",
            "type": "enum(subheading|heading|display|displayLg|displayXl|display2xl)",
            "required": false,
            "default": "heading"
          },
          {
            "name": "entranceAnimation",
            "type": "enum(fadeIn|slideUp|slideDown|slideLeft|slideRight|scaleIn|rotateIn|tiltX|tiltY|flipX|flipY|zoomRotate|elasticScale|swingIn)",
            "required": false,
            "default": "slideUp"
          }
        ]
      },
      {
        "name": "TextHighlight",
        "durationExpression": "ceil(props.animationDelay + props.zoomDuration)",
        "tags": [],
        "id": "texthighlight",
        "description": "Bold statement with an emphasized word/phrase. Use for key claims. Use {} to highlight. eg \"We build amazing {software}\"",
        "props": [
          {
            "name": "text",
            "type": "string",
            "required": true,
            "default": ""
          },
          {
            "name": "variant",
            "type": "enum(subheading|heading|display|displayLg|displayXl|display2xl)",
            "required": false,
            "default": "heading"
          },
          {
            "name": "highlightStyle",
            "type": "enum(marker|underline|box|glow|background)",
            "required": false,
            "default": "glow"
          },
          {
            "name": "highlightedTextAnimation",
            "type": "enum(zoom|jump)",
            "required": false,
            "default": "jump"
          },
          {
            "name": "highlightColor",
            "type": "string",
            "required": false
          },
          {
            "name": "entranceAnimation",
            "type": "enum(fadeIn|slideUp|slideDown|slideLeft|slideRight|scaleIn|rotateIn|tiltX|tiltY|flipX|flipY|zoomRotate|elasticScale|swingIn)",
            "required": false,
            "default": "slideUp"
          },
          {
            "name": "animationDelay",
            "type": "number",
            "required": false,
            "default": 30
          },
          {
            "name": "zoomDuration",
            "type": "number",
            "required": false,
            "default": 30
          }
        ]
      },
      {
        "name": "TextCycle",
        "durationExpression": "ceil((props.holdDuration + props.transitionDuration) * size(props.texts))",
        "tags": [],
        "id": "textcycle",
        "description": "rotating text strings or words. Use for taglines, feature lists, multi highlights",
        "props": [
          {
            "name": "texts",
            "type": "array",
            "required": true,
            "subtype": "string",
            "default": []
          },
          {
            "name": "holdDuration",
            "type": "number",
            "required": false,
            "default": 20
          },
          {
            "name": "transitionDuration",
            "type": "number",
            "required": false,
            "default": 5
          },
          {
            "name": "transition",
            "type": "enum(flipY|fadeSwap|slideUp)",
            "required": false,
            "default": "slideUp"
          },
          {
            "name": "variant",
            "type": "enum(subheading|heading|display|displayLg|displayXl|display2xl)",
            "required": false,
            "default": "displayXl"
          }
        ]
      },
      {
        "name": "TextWithWordCycle",
        "durationExpression": "ceil((props.holdDuration + props.transitionDuration) * size(props.cyclingWords))",
        "tags": [],
        "id": "textwithwordcycle",
        "description": "Static text with cycling highlighted words at the end. Use for dynamic taglines like \"We build amazing [software/products/solutions]\"",
        "props": [
          {
            "name": "text",
            "type": "string",
            "required": true,
            "default": ""
          },
          {
            "name": "cyclingWords",
            "type": "array",
            "required": true,
            "subtype": "string",
            "default": []
          },
          {
            "name": "holdDuration",
            "type": "number",
            "required": false,
            "default": 20
          },
          {
            "name": "transitionDuration",
            "type": "number",
            "required": false,
            "default": 10
          },
          {
            "name": "transition",
            "type": "enum(flipY|fadeSwap|slideUp)",
            "required": false,
            "default": "slideUp"
          },
          {
            "name": "variant",
            "type": "enum(subheading|heading|display|displayLg|displayXl|display2xl)",
            "required": false,
            "default": "heading"
          },
          {
            "name": "highlightStyle",
            "type": "enum(marker|underline|box|glow|background)",
            "required": false,
            "default": "background"
          },
          {
            "name": "highlightColor",
            "type": "string",
            "required": false
          }
        ]
      },
      {
        "name": "AnimatedImage",
        "durationExpression": "80",
        "tags": [
          "Solution",
          "Product Info"
        ],
        "id": "animatedimage",
        "description": "Label + image entrance. Use for product/feature visuals.",
        "props": [
          {
            "name": "text",
            "type": "string",
            "required": true,
            "default": ""
          },
          {
            "name": "src",
            "type": "string",
            "required": true
          },
          {
            "name": "variant",
            "type": "enum(subheading|heading|display|displayLg|displayXl|display2xl)",
            "required": false,
            "default": "subheading"
          },
          {
            "name": "entranceAnimation",
            "type": "enum(fadeIn|slideUp|slideDown|slideLeft|slideRight|scaleIn|rotateIn|tiltX|tiltY|flipX|flipY|zoomRotate|elasticScale|swingIn)",
            "required": false,
            "default": "slideUp"
          },
          {
            "name": "width",
            "type": "number",
            "required": false,
            "default": 1344
          },
          {
            "name": "height",
            "type": "number",
            "required": false,
            "default": 756
          }
        ]
      },
      {
        "name": "AnimatedVideo",
        "durationExpression": "500",
        "tags": [
          "Solution",
          "Product Info"
        ],
        "id": "animatedvideo",
        "description": "Label + video entrance. Duration = video length.",
        "props": [
          {
            "name": "text",
            "type": "string",
            "required": true,
            "default": ""
          },
          {
            "name": "src",
            "type": "string",
            "required": true
          },
          {
            "name": "variant",
            "type": "enum(subheading|heading|display|displayLg|displayXl|display2xl)",
            "required": false,
            "default": "subheading"
          },
          {
            "name": "entranceAnimation",
            "type": "enum(fadeIn|slideUp|slideDown|slideLeft|slideRight|scaleIn|rotateIn|tiltX|tiltY|flipX|flipY|zoomRotate|elasticScale|swingIn)",
            "required": false,
            "default": "slideUp"
          },
          {
            "name": "width",
            "type": "number",
            "required": false,
            "default": 1344
          },
          {
            "name": "height",
            "type": "number",
            "required": false,
            "default": 756
          }
        ]
      },
      {
        "name": "ContentAwareScene",
        "tags": [],
        "id": "contentawarescene",
        "description": "Automatically chooses a media-and-text layout from image or video dimensions and text visual weight.Pass textComponent as one of TextStagger, TextHighlight, Typewriter, or TextWithWordCycle.",
        "props": [
          {
            "name": "src",
            "type": "string",
            "required": true
          },
          {
            "name": "mediaType",
            "type": "enum(img|video)",
            "required": false,
            "default": "img"
          },
          {
            "name": "entranceAnimation",
            "type": "enum(fadeIn|slideUp|slideDown|slideLeft|slideRight|scaleIn|rotateIn|tiltX|tiltY|flipX|flipY|zoomRotate|elasticScale|swingIn)",
            "required": false,
            "default": "slideUp"
          },
          {
            "name": "textComponent",
            "type": "any",
            "required": true
          }
        ]
      },
      {
        "name": "ImagePeel",
        "durationExpression": "ceil(30 + size(props.images) * (props.holdDuration + props.peelDuration))",
        "tags": [
          "Solution",
          "Product Info"
        ],
        "id": "imagepeel",
        "description": "Images peel away one by one. Use for before/after or variations. Min 2 images.",
        "props": [
          {
            "name": "images",
            "type": "array",
            "required": true,
            "subtype": "string"
          },
          {
            "name": "direction",
            "type": "enum(left|right|up|down)",
            "required": false,
            "default": "right"
          },
          {
            "name": "holdDuration",
            "type": "number",
            "required": false,
            "default": 20
          },
          {
            "name": "peelDuration",
            "type": "number",
            "required": false,
            "default": 20
          },
          {
            "name": "stackOffset",
            "type": "number",
            "required": false,
            "default": 20
          },
          {
            "name": "width",
            "type": "number",
            "required": false,
            "default": 1344
          },
          {
            "name": "height",
            "type": "number",
            "required": false,
            "default": 756
          }
        ]
      },
      {
        "name": "LogoAsset",
        "durationExpression": "props.logoAnimation == \"none\" ? 30 : 30",
        "tags": [
          "CTA"
        ],
        "id": "logoasset",
        "description": "Logo reveal. Default is brand logo, no props. Use as the final scene.",
        "props": [
          {
            "name": "src",
            "type": "string",
            "required": false,
            "default": ""
          },
          {
            "name": "width",
            "type": "number",
            "required": false
          },
          {
            "name": "height",
            "type": "number",
            "required": false
          },
          {
            "name": "logoAnimation",
            "type": "enum(none|fadeIn|zoomIn|bounceIn|spinIn|dropIn)",
            "required": false,
            "default": "zoomIn"
          }
        ]
      },
      {
        "name": "LogoShowcase",
        "durationExpression": "ceil((size(props.text.split(\"\\n\")) - 1) * 10 + 20 + (size(props.images) - 1) * 5 + 12)",
        "tags": [
          "Solution",
          "Product Info",
          "Social proof"
        ],
        "id": "logoshowcase",
        "description": "Row of logos + caption. Use for integrations, tech stack, partners, brands. eg. logos=[\"url1\", \"url2\"], text=\"caption text\".",
        "props": [
          {
            "name": "images",
            "type": "array",
            "required": true,
            "subtype": "string",
            "default": []
          },
          {
            "name": "text",
            "type": "string",
            "required": true,
            "default": ""
          },
          {
            "name": "variant",
            "type": "enum(subheading|heading|display|displayLg|displayXl|display2xl)",
            "required": false,
            "default": "heading"
          },
          {
            "name": "logoGap",
            "type": "number",
            "required": false,
            "default": 48
          }
        ]
      },
      {
        "name": "LogoWithBrandName",
        "durationExpression": "ceil((size(props.brandName.split(\"\")) - 1) * 5 + 20)",
        "tags": [
          "Solution"
        ],
        "id": "logowithbrandname",
        "description": "Logo + brand name reveal. Use for brand intro.",
        "props": [
          {
            "name": "brandName",
            "type": "string",
            "required": true,
            "default": ""
          },
          {
            "name": "src",
            "type": "string",
            "required": false,
            "default": ""
          },
          {
            "name": "logoSize",
            "type": "number",
            "required": false
          },
          {
            "name": "variant",
            "type": "enum(subheading|heading|display|displayLg|displayXl|display2xl)",
            "required": false,
            "default": "heading"
          }
        ]
      },
      {
        "name": "IconShowcase",
        "durationExpression": "ceil(10 + (size(props.icons) - 1) * 5 + 10 + 5 + 15 + (size(props.text.trim().split(\" \")) - 1) * 5 + 15)",
        "tags": [
          "Solution",
          "Product Info",
          "Social proof"
        ],
        "id": "iconshowcase",
        "description": "Row of icons + caption. Use for integrations, tech stack, partners, brands. eg. icons={[\"shopify\", \"midjourney\", \"openai\"]}, text=\"caption text\".",
        "props": [
          {
            "name": "icons",
            "type": "array",
            "required": true,
            "subtype": "string",
            "default": []
          },
          {
            "name": "text",
            "type": "string",
            "required": true,
            "default": ""
          },
          {
            "name": "variant",
            "type": "enum(subheading|heading|display|displayLg|displayXl|display2xl)",
            "required": false,
            "default": "heading"
          },
          {
            "name": "iconSize",
            "type": "number",
            "required": false,
            "default": 90
          },
          {
            "name": "iconGap",
            "type": "number",
            "required": false,
            "default": 64
          }
        ]
      }
    ]
  }
]
