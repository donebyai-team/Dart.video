              ]
            }
          ],
          "llmSchema": [
            {
              "name": "text",
              "type": "string"
            },
            {
              "name": "src",
              "type": "string"
            }
          ],
          "description": "Label + image entrance. Use for product/feature visuals.",
          "celExpression": "80"
        },
        {
          "name": "AnimatedVideo",
          "type": "scene",
          "tags": [
            "Solution",
            "Product Info"
          ],
          "schema": [
            {
              "type": "component",
              "name": "scene",
              "fields": [
                {
                  "name": "entranceAnimation",
                  "type": "string",
                  "subtype": "enum",
                  "default": "slideUp"
                }
              ]
            },
            {
              "type": "component",
              "name": "text",
              "fields": [
                {
                  "name": "text",
                  "type": "string",
                  "subtype": "content",
                  "map": "props.text"
                },
                {
                  "name": "variant",
