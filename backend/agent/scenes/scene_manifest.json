        "subheading",
        "heading",
        "display",
        "displayLg",
        "displayXl",
        "display2xl"
      ]
    },
    {
      "name": "entranceAnimation",
      "description": "used for entrance animations",
      "value": [
        "fadeIn",
        "slideUp",
        "slideDown",
        "slideLeft",
        "slideRight",
        "scaleIn",
        "rotateIn",
        "tiltX",
        "tiltY",
        "flipX",
        "flipY",
        "zoomRotate",
        "elasticScale",
        "swingIn"
      ]
    },
    {
      "name": "splitBy",
      "value": [
        "char",
        "word",
        "line"
      ]
    },
    {
      "name": "logoAnimation",
      "value": [
        "none",
        "fadeIn",
        "zoomIn",
        "bounceIn",
        "spinIn",
        "dropIn"
      ]
    },
    {
      "name": "direction",
      "value": [
        "left",
        "right",
        "up",
        "down"
      ]
    },
    {
      "name": "highlightStyle",
      "value": [
        "marker",
        "underline",
        "box",
        "glow",
        "background"
      ]
    },
    {
      "name": "textCycleTransition",
      "value": [
        "flipY",
        "fadeSwap",
        "slideUp"
      ]
    },
    {
      "name": "highlightedTextAnimation",
      "value": [
        "zoom",
        "jump"
      ]
    }
  ],
  "components": [
    {
      "title": "Scenes",
      "description": "standalone, no siblings",
      "components": [
        {
          "name": "AnimatedNumber",
          "type": "content",
          "schema": [
            {
              "type": "component",
              "name": "animatednumber",
              "fields": [
                {
                  "name": "entranceAnimation",
                  "type": "string",
                  "default": "slideUp"
                },
                {
                  "name": "animationDelay",
                  "type": "number",
                  "default": 30
                },
                {
                  "name": "startText",
                  "type": "string",
                  "map": "props.startText"
                },
                {
                  "name": "endText",
                  "type": "string",
                  "map": "props.endText"
                },
                {
                  "name": "from",
                  "type": "number",
                  "map": "props.from",
                  "default": 0
                },
                {
                  "name": "to",
                  "type": "number",
                  "map": "props.to",
                  "default": 100
                },
                {
                  "name": "format",
                  "type": "string",
                  "default": ""
                },
                {
                  "name": "variant",
                  "type": "string",
                  "subtype": "enum",
                  "default": "heading"
                }
              ]
            }
          ],
          "llmSchema": [
            {
              "name": "startText",
              "type": "string"
            },
            {
              "name": "endText",
              "type": "string"
            },
            {
              "name": "from",
              "type": "number"
            },
            {
              "name": "to",
              "type": "number"
            }
          ],
          "description": "Counting metric with label text. Use for stats and KPIs",
          "celExpression": "props.animatednumber.animationDelay + max(45, min(100, log10(abs(props.animatednumber.to - props.animatednumber.from) + 1) * 20))"
        },
        {
          "name": "TextStagger",
          "type": "content",
          "schema": [
            {
              "type": "component",
              "name": "textstagger",
              "fields": [
                {
                  "name": "text",
                  "type": "string",
                  "map": "props.text"
                },
                {
                  "name": "variant",
                  "type": "string",
                  "subtype": "enum",
                  "default": "heading"
                },
                {
                  "name": "staggerDelay",
                  "type": "number",
                  "default": 5
                },
                {
                  "name": "entranceAnimation",
                  "type": "string",
                  "subtype": "enum",
                  "default": "scaleIn"
                },
                {
                  "name": "duration",
                  "type": "number",
                  "default": 15
                },
                {
                  "name": "splitBy",
                  "type": "string",
                  "subtype": "enum",
                  "default": "word"
                }
              ]
            }
          ],
          "llmSchema": [
            {
              "name": "text",
              "type": "string"
            }
          ],
          "description": "Reveals a word or full text phrase word-by-word. Works for both single word and multi-word headlines or body text.",
          "celExpression": "(segmentCount(props.textstagger.text, props.textstagger.splitBy) * props.textstagger.staggerDelay) + props.textstagger.duration"
        },
        {
          "name": "Typewriter",
          "type": "content",
          "schema": [
            {
              "type": "component",
              "name": "typewriter",
              "fields": [
                {
                  "name": "text",
                  "type": "string",
                  "required": true,
                  "map": "props.text"
                },
                {
                  "name": "variant",
                  "type": "string",
                  "subtype": "enum",
                  "default": "heading"
                },
                {
                  "name": "splitBy",
                  "type": "string",
                  "subtype": "enum",
                  "default": "char"
                },
                {
                  "name": "entranceAnimation",
                  "type": "string",
                  "subtype": "enum",
                  "default": "slideUp"
                },
                {
                  "name": "startAt",
                  "type": "number",
                  "default": 0
                }
              ]
            }
          ],
          "llmSchema": [
            {
              "name": "text",
              "type": "string"
            }
          ],
          "description": "Character-by-character text reveal. Use for dramatic reveals or code/terminal effects.",
          "celExpression": "max(60, segmentCount(props.typewriter.text, props.typewriter.splitBy) * (props.typewriter.splitBy == \"char\" ? 2 : props.typewriter.splitBy == \"word\" ? 9 : 18))"
        },
        {
          "name": "TextHighlight",
          "type": "content",
          "schema": [
            {
              "type": "component",
              "name": "texthighlight",
              "fields": [
                {
                  "name": "text",
                  "type": "string",
                  "map": "props.text"
                },
                {
                  "name": "variant",
                  "type": "string",
                  "subtype": "enum",
                  "default": "heading"
                },
                {
                  "name": "entranceAnimation",
                  "type": "string",
                  "subtype": "enum",
                  "default": "slideUp"
                },
                {
                  "name": "animationDelay",
                  "type": "number",
                  "default": 30
                },
                {
                  "name": "zoomDuration",
                  "type": "number",
                  "default": 30
                },
                {
                  "name": "highlightStyle",
                  "type": "string",
                  "subtype": "enum",
                  "default": "glow"
                },
                {
                  "name": "highlightedTextAnimation",
                  "type": "string",
                  "subtype": "enum",
                  "default": "jump"
                },
                {
                  "name": "highlightColor",
                  "type": "string",
                  "subtype": "color"
                }
              ]
            }
          ],
          "llmSchema": [
            {
              "name": "text",
              "type": "string"
            }
          ],
          "description": "Bold statement with an emphasized word/phrase. Use for key claims. Use {} to highlight. eg \"We build amazing {software}\"",
          "celExpression": "props.texthighlight.animationDelay + props.texthighlight.zoomDuration"
        },
        {
          "name": "TextCycle",
          "type": "content",
          "schema": [
            {
              "type": "component",
              "name": "textcycle",
              "fields": [
                {
                  "name": "texts",
                  "type": "array",
                  "subtype": "string",
                  "map": "props.texts"
                },
                {
                  "name": "variant",
                  "type": "string",
                  "subtype": "enum",
                  "default": "display"
                },
                {
                  "name": "entranceAnimation",
                  "type": "string",
                  "subtype": "enum",
                  "default": "slideUp"
                },
                {
                  "name": "textCycleTransition",
                  "type": "string",
                  "subtype": "enum",
                  "default": "slideUp"
                },
                {
                  "name": "holdDuration",
                  "type": "number",
                  "default": 20
                },
                {
                  "name": "transitionDuration",
                  "type": "number",
                  "default": 5
                }
              ]
            }
          ],
          "llmSchema": [
            {
              "name": "texts",
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          ],
          "description": "Rotates through words or text strings. Works for both single words and longer phrases. Use for taglines, feature lists, or highlighting multiple key points.",
          "celExpression": "(props.textcycle.holdDuration + props.textcycle.transitionDuration) * size(props.textcycle.texts)"
        },
        {
          "name": "TextWithWordCycle",
          "type": "content",
          "schema": [
            {
              "type": "component",
              "name": "textwithwordcycle",
              "fields": [
                {
                  "name": "text",
                  "type": "string",
                  "map": "props.text"
                },
                {
                  "name": "cyclingWords",
                  "type": "array",
                  "map": "props.cyclingWords",
                  "default": []
                },
                {
                  "name": "variant",
                  "type": "string",
                  "sub_type": "enum",
                  "default": "heading"
                },
                {
                  "name": "entranceAnimation",
                  "type": "string",
                  "subtype": "enum",
                  "default": "slideUp"
                },
                {
                  "name": "holdDuration",
                  "type": "number",
                  "default": 20
                },
                {
                  "name": "transitionDuration",
                  "type": "number",
                  "default": 10
                },
                {
                  "name": "textCycleTransition",
                  "type": "string",
                  "subtype": "enum",
                  "default": "slideUp"
                },
                {
                  "name": "highlightStyle",
                  "type": "string",
                  "subtype": "enum",
                  "default": "background"
                }
              ]
            }
          ],
          "llmSchema": [
            {
              "name": "text",
              "type": "string"
            },
            {
              "name": "cyclingWords",
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          ],
          "description": "Static text with cycling highlighted words at the end. Use for dynamic taglines like \"We build amazing [software/products/solutions]\"",
          "celExpression": "(props.textwithwordcycle.holdDuration + props.textwithwordcycle.transitionDuration) * size(props.textwithwordcycle.cyclingWords)"
        },
        {
          "name": "TextLeadStagger",
          "type": "content",
          "schema": [
            {
              "type": "component",
              "name": "textleadstagger",
              "fields": [
                {
                  "name": "text",
                  "type": "string",
                  "map": "props.text"
                },
                {
                  "name": "variant",
                  "type": "string",
                  "subtype": "enum",
                  "default": "displayLg"
                },
                {
                  "name": "entranceAnimation",
                  "type": "string",
                  "subtype": "enum",
                  "default": "slideLeft"
                },
                {
                  "name": "speed",
                  "type": "number",
                  "default": 100
                }
              ]
            }
          ],
          "llmSchema": [
            {
              "name": "text",
              "type": "string"
            }
          ],
          "celExpression": "((40 + max(0, segmentCount(props.textleadstagger.text, \"word\") - 2) * 5 + max(0, segmentCount(props.textleadstagger.text, \"word\") - 1) * 4) * 100) / max(25, props.textleadstagger.speed)",
          "description": "First word starts enlarged and then settles down. The remaining words enter in a stagger, making it ideal for emphasis moments (MAX 3–4 words).\nExamples:\ntext=\"Isn't getting clicks\"\ntext=\"You're missing out\"\n\nYou can combine it with other **fillers scenes** for showcasing a **\"Problem\" or \"Solution\" section** of a video or use it as a standalone filler with other scenes.\n\nExample problem: \"If your Airbnb listing isn't getting clicks\"\n\n- Scene 1: If (TextStagger)\n- Scene 2: your (TextStagger)\n- Scene 3: Airbnb {listing} (TextHighlight)\n- Scene 4: isn't getting clicks (TextLeadStagger)"
        },
