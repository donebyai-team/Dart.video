                },
                {
                  "name": "width",
                  "type": "number",
                  "default": 1344
                },
                {
                  "name": "height",
                  "type": "number",
                  "default": 756
                }
              ]
            }
          ],
          "llmSchema": [
            {
              "name": "text",
              "type": "string"
            },
            {
              "name": "src",
              "type": "string"
            }
          ],
          "description": "Label + video entrance. Duration = video length.",
          "celExpression": "500"
        },
        {
          "name": "ImagePeel",
          "type": "scene",
          "tags": [
            "Solution",
            "Product Info"
          ],
          "schema": [
            {
              "type": "repeat",
              "source": "images",
              "map": "props.images",
              "components": [
                {
                  "name": "imageasset",
                  "fields": [
                    {
                      "name": "src",
                      "type": "string",
                      "map": "item"
                    },
                    {
                      "name": "width",
                      "type": "number",
                      "default": 1344
                    },
                    {
                      "name": "height",
                      "type": "number",
                      "default": 756
                    }
                  ]
                }
              ]
            },
            {
              "type": "component",
              "name": "scene",
              "fields": [
                {
                  "name": "direction",
                  "type": "string",
                  "subtype": "enum",
                  "default": "right"
                },
                {
                  "name": "holdDuration",
                  "type": "number",
                  "default": 20
                },
                {
                  "name": "peelDuration",
                  "type": "number",
                  "default": 20
                },
                {
                  "name": "stackOffset",
                  "type": "number",
                  "default": 20
                }
              ]
            }
          ],
          "llmSchema": [
            {
              "name": "images",
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          ],
          "description": "Images peel away one by one. Use for before/after or variations. Min 2 images.",
          "celExpression": "ceil(30 + size(props.images) * (props.scene.holdDuration + props.scene.peelDuration))"
        },
