{
  "extends": "../packages/ts-config/base",
  "compilerOptions": {
    "target": "es5",
    "module": "esnext",
    "incremental": true,
    "jsx": "preserve",
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/*": [
        "./src/*"
      ],
      "@/store/*": [
        "./stores/*"
      ]
    },
    "strictNullChecks": true
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts"
, "../packages/template-registery.ts"  ],
  "exclude": [
    "node_modules"
  ]
}
