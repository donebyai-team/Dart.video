FROM node:20-bookworm

RUN corepack enable && corepack prepare pnpm@9.15.5 --activate
RUN apt-get update && apt-get install -y --no-install-recommends \
  ffmpeg \
  ca-certificates \
  fonts-liberation \
  fonts-noto-color-emoji \
  libasound2 \
  libatk-bridge2.0-0 \
  libatk1.0-0 \
  libc6 \
  libcairo2 \
  libcups2 \
  libdbus-1-3 \
  libdrm2 \
  libexpat1 \
  libfontconfig1 \
  libgbm1 \
  libgcc1 \
  libglib2.0-0 \
  libgtk-3-0 \
  libnspr4 \
  libnss3 \
  libpango-1.0-0 \
  libpangocairo-1.0-0 \
  libstdc++6 \
  libx11-6 \
  libx11-xcb1 \
  libxcb1 \
  libxcomposite1 \
  libxcursor1 \
  libxdamage1 \
  libxext6 \
  libxfixes3 \
  libxi6 \
  libxrandr2 \
  libxrender1 \
  libxshmfence1 \
  libxss1 \
  libxtst6 \
  xdg-utils \
  && rm -rf /var/lib/apt/lists/*

WORKDIR /app

COPY package.json pnpm-lock.yaml pnpm-workspace.yaml ./

# Full source for packages the renderer actually depends on
COPY packages/animation ./packages/animation
COPY packages/renderer ./packages/renderer
COPY packages/pb ./packages/pb
COPY packages/ts-config ./packages/ts-config

# package.json only for remaining workspace packages (pnpm lockfile resolution)
COPY packages/client/package.json ./packages/client/package.json
COPY packages/mui-config/package.json ./packages/mui-config/package.json
COPY packages/store/package.json ./packages/store/package.json
COPY packages/tailwind-config/package.json ./packages/tailwind-config/package.json
COPY packages/ui-core/package.json ./packages/ui-core/package.json
COPY packages/vitejs-config/package.json ./packages/vitejs-config/package.json

# pnpm workspace requires portal/package.json to exist for dep resolution,
# but we don't need portal source code in this image
COPY portal/package.json ./portal/package.json

RUN pnpm install --frozen-lockfile

WORKDIR /app/packages/renderer
ENV NODE_ENV=production
RUN pnpm exec remotion browser ensure

# Pre-bundle the Remotion composition so render-cloudrun.mjs skips webpack at runtime.
# Output: /app/portal/remotion-bundle
RUN pnpm node scripts/prebundle.mjs

CMD ["pnpm", "run", "render:cloudrun"]
