{
  "name": "@coasterai/renderer",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@9.15.5",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "scripts": {
    "type-check": "tsc --noEmit",
    "generate:shape-props": "node ./scripts/generate-remotion-shapes-props.mjs",
    "deploy:remotion": "./scripts/deploy-remotion-cloudrun.sh",
    "deploy:validator": "./scripts/deploy-validator-cloudrun.sh",
    "render": "pnpm exec remotion render src/remotion-entry.ts MyComposition out.mp4 --scale=0.5",
    "render:cloudrun": "node ./scripts/render-cloudrun.mjs",
    "validate:server": "tsx ./scripts/validate-server.mjs",
    "test": "jest --config jest.config.cjs"
  },
  "dependencies": {
    "@babel/standalone": "7.28.5",
    "@bufbuild/protobuf": "catalog:",
    "@coasterai/animation": "workspace:*",
    "@coasterai/pb": "workspace:*",
    "@google-cloud/storage": "^7.15.2",
    "@remotion/bundler": "4.0.421",
    "@remotion/layout-utils": "^4.0.432",
    "@remotion/preload": "4.0.421",
    "@remotion/renderer": "4.0.421",
    "ioredis": "^5.3.2",
    "lucide-react": "^0.408.0",
    "react": "catalog:",
    "react-dom": "18.3.1",
    "react-hot-toast": "2.4.1",
    "swc-loader": "^0.2.7",
    "tsx": "^4.19.0",
    "remotion": "4.0.421"
  },
  "peerDependencies": {
    "@remotion/transitions": "*"
  },
  "devDependencies": {
    "@coasterai/ts-config": "workspace:*",
    "@remotion/cli": "4.0.421",
    "@types/babel__standalone": "^7.1.9"
  }
}
