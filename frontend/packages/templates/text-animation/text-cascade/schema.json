{
  "name": "slide_center_text_schema",
  "schema": {
    "type": "object",
    "additionalProperties": false,
    "required": ["centerText"],
    "properties": {
      "centerText": {
        "type": "object",
        "description": "Main text displayed at the center of the slide",
        "additionalProperties": false,
        "required": ["text", "style"],
        "properties": {
          "text": {
            "type": "string",
            "description": "Main text content displayed at the center",
            "minLength": 10,
            "maxLength": 50
          },
          "style": {
            "type": "object",
            "additionalProperties": false,
            "required": ["fontSize", "color", "lineHeight", "fontFamily"],
            "properties": {
              "fontSize": {
                "type": "number"
              },
              "color": {
                "type": "string"
              },
              "lineHeight": {
                "type": "number"
              },
              "textAlign": {
                "type": "string",
                "enum": ["left", "center", "right", "justify"]
              },
              "fontWeight": {
                "type": "string",
                "enum": [
                  "normal",
                  "bold",
                  "bolder",
                  "lighter",
                  "300",
                  "400",
                  "500",
                  "600",
                  "700"
                ]
              },
              "fontFamily": {
                "type": "string",
                "enum": [
                  "Inter",
                  "Urbanist",
                  "Arial",
                  "Poppins",
                  "Roboto",
                  "Georgia",
                  "Times New Roman",
                  "Courier New"
                ]
              }
            }
          }
        }
      }
    }
  }
}